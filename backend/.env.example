# AgroSafe Travel Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# Supabase Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Authentication
JWT_SECRET=super-secret-jwt-key-agrosafe-2026
JWT_EXPIRES_IN=7d

# Email configs
SMTP_HOST=smtp.gmail.com                                                                   
SMTP_PORT=465                                                                              
SMTP_SECURE=true                                                                           
SMTP_USER=your_email@gmail.com                                                             
SMTP_PASS=abcdefghijklmnop                                                                 
EMAIL_FROM=AgroSafe Travel <your_email@gmail.com>
APP_URL=https://vijay-agro-full.vercel.app

# Admin recipient for payment notifications
ADMIN_EMAIL=admin@example.com

# Razorpay (test/trial mode) [ from https://dashboard.razorpay.com/app/keys ]
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key for Path B Incident Photo Vision AI Classifier
# Free tier from Google AI Studio: https://aistudio.google.com/app/apikey (15 req/min, 1,500 req/day free)
GEMINI_API_KEY=your_gemini_api_key_here