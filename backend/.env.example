# AgroSafe Travel Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# Supabase Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Authentication
JWT_SECRET=super-secret-jwt-key-agrosafe-2026
JWT_EXPIRES_IN=7d

# Email / Notification Configurations
# Set provider to: 'brevo' (no custom domain needed) or 'resend' (requires custom domain to email others)
EMAIL_PROVIDER=brevo

# 1. Brevo SMTP (Recommended when you don't have a domain: free 300 emails/day to ANY email address)
# Get credentials at: Brevo Dashboard -> Settings -> SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_master_key
EMAIL_FROM=AgroSafe Travel <your_verified_brevo_email@gmail.com>
APP_URL=http://localhost:3000

# 2. Resend API (Only allows sending to your own signup email unless you have a custom verified domain)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx


# Admin recipient for payment notifications
ADMIN_EMAIL=admin@example.com

# Razorpay (test/trial mode) [ from https://dashboard.razorpay.com/app/keys ]
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key for Path B Incident Photo Vision AI Classifier
# Free tier from Google AI Studio: https://aistudio.google.com/app/apikey (15 req/min, 1,500 req/day free)
GEMINI_API_KEY=your_gemini_api_key_here